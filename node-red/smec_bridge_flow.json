    "id": "smec000000000003",
    "type": "function",
    "z": "smec000000000001",
    "g": "smec000000000002",
    "name": "Uptime input",
    "func": "// Uptime input for the SMEC Bridge app.\n// Input:  msg.topic   = machine (e.g. \"STATION_1\")\n//         msg.payload = value (e.g. 1)\n// The app sends it on to the main system and records it in its History.\nmsg.payload = { station: msg.topic, signal: \"uptime\", value: msg.payload };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
