    "name": "Count packet",
    "func": "// Builds the Count packet for the PNA API.\n// Input:  msg.topic   = machine (e.g. \"STATION_1\")\n//         msg.payload = value to send (e.g. 1)\nconst mc = msg.topic;\nconst value = msg.payload;\nconst pkg = \"005\";\n\n// Malaysia time, YYYY-MM-DD HH:MM:SS\nconst t = new Date(Date.now() + 8 * 3600 * 1000).toISOString();\nconst dt = t.slice(0, 10) + \" \" + t.slice(11, 19);\n\n// msg_no counter per machine, restarts at 1 each day\nconst seq = context.get(\"seq\") || {};\nif (!seq[mc] || seq[mc].day !== dt.slice(0, 10)) seq[mc] = { day: dt.slice(0, 10), n: 0 };\nseq[mc].n += 1;\ncontext.set(\"seq\", seq);\n\nmsg.payload = { data: { data: {\n    datetime: dt,\n    mc_no: mc,\n    count: String(value),\n    package_no: pkg,\n    msg_no: mc + \"/\" + pkg + \"_\" + dt + \"_\" + seq[mc].n\n} } };\nreturn msg;",
